{
  "name": "PickTicket",
  "type": "object",
  "properties": {
    "ticket_number": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "description": "The customer the order belongs to."
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "done",
        "cancelled"
      ],
      "default": "open",
      "description": "Inventory is deducted ONLY when status transitions to done, after the yard worker verifies physical counts."
    },
    "pick_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "unit_of_measure": {
            "type": "string"
          },
          "requested_quantity": {
            "type": "number"
          },
          "verified_quantity": {
            "type": "number"
          },
          "line_status": {
            "type": "string",
            "enum": [
              "pending",
              "verified",
              "short"
            ],
            "default": "pending"
          }
        },
        "required": [
          "product_id",
          "name",
          "requested_quantity",
          "line_status"
        ]
      }
    },
    "assigned_to": {
      "type": "string",
      "description": "Staff user assigned to pick the order."
    },
    "verified_by": {
      "type": "string",
      "description": "Staff user who confirmed physical counts at the loading dock."
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "order_id",
    "user_id",
    "status",
    "pick_items"
  ]
}