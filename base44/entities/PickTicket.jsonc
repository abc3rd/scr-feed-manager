{
  "name": "PickTicket",
  "type": "object",
  "properties": {
    "ticket_number": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "user_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "The customer the order belongs to."
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "done",
        "cancelled"
      ],
      "default": "open",
      "description": "Inventory is deducted ONLY when status transitions to done, after the yard worker verifies physical counts."
    },
    "pick_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "unit_of_measure": {
            "type": "string"
          },
          "requested_quantity": {
            "type": "number"
          },
          "verified_quantity": {
            "type": "number"
          },
          "line_status": {
            "type": "string",
            "enum": [
              "pending",
              "verified",
              "short"
            ],
            "default": "pending"
          }
        },
        "required": [
          "product_id",
          "name",
          "requested_quantity",
          "line_status"
        ]
      }
    },
    "assigned_to": {
      "type": [
        "string",
        "null"
      ]
    },
    "verified_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "verified_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "order_id",
    "status",
    "pick_items"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    }
  }
}