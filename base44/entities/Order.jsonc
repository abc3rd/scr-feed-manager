{
  "name": "Order",
  "properties": {
    "checkout_channel": {
      "description": "Where payment happens: 'shopify' (Shopify checkout on scrfeed.com).",
      "type": [
        "string",
        "null"
      ]
    },
    "checkout_url": {
      "description": "Shopify cart permalink the customer was sent to. The Shopify order carries this order's number as the 'SCR order' cart attribute.",
      "type": [
        "string",
        "null"
      ]
    },
    "delivery_address": {
      "description": "Required when fulfillment_type is delivery.",
      "type": [
        "string",
        "null"
      ]
    },
    "discount_amount": {
      "default": 0,
      "type": "number"
    },
    "fulfillment_type": {
      "default": "pickup",
      "description": "How the customer wants the order fulfilled. Set at checkout (including from the Barn Profile quick-order form).",
      "enum": [
        "pickup",
        "delivery"
      ],
      "type": "string"
    },
    "items": {
      "items": {
        "properties": {
          "line_total": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "shopify_variant_id": {
            "type": "string"
          },
          "unit_of_measure": {
            "type": "string"
          },
          "unit_price": {
            "type": "number"
          }
        },
        "required": [
          "product_id",
          "name",
          "quantity",
          "unit_price",
          "line_total"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "order_number": {
      "type": "string"
    },
    "payment_status": {
      "default": "unpaid",
      "enum": [
        "unpaid",
        "paid",
        "refunded",
        "failed"
      ],
      "type": "string"
    },
    "points_earned": {
      "default": 0,
      "type": "number"
    },
    "points_redeemed": {
      "default": 0,
      "type": "number"
    },
    "status": {
      "default": "pending",
      "description": "pending = order placed. ticket_generated = pick ticket(s) created. picking = yard worker assigned. partially_fulfilled = some tickets done, others open. completed = ALL tickets done; loyalty points awarded at this transition only.",
      "enum": [
        "pending",
        "ticket_generated",
        "picking",
        "partially_fulfilled",
        "completed",
        "cancelled"
      ],
      "type": "string"
    },
    "stripe_session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "subtotal": {
      "type": "number"
    },
    "tier_applied": {
      "description": "Deprecated: tier discounts were removed (ADR 0001). Always null on new orders.",
      "type": [
        "string",
        "null"
      ]
    },
    "total": {
      "type": "number"
    },
    "user_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "status",
    "items",
    "total"
  ],
  "type": "object",
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "staff"
          }
        }
      ]
    }
  }
}