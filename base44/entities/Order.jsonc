{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string"
    },
    "user_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "ticket_generated",
        "picking",
        "partially_fulfilled",
        "completed",
        "cancelled"
      ],
      "default": "pending",
      "description": "pending = order placed. ticket_generated = pick ticket(s) created. picking = yard worker assigned. partially_fulfilled = some tickets done, others open. completed = ALL tickets done; loyalty points awarded at this transition only."
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "paid",
        "refunded",
        "failed"
      ],
      "default": "unpaid"
    },
    "fulfillment_type": {
      "type": "string",
      "enum": [
        "pickup",
        "delivery"
      ],
      "default": "pickup",
      "description": "How the customer wants the order fulfilled. Set at checkout (including from the Barn Profile quick-order form)."
    },
    "delivery_address": {
      "type": [
        "string",
        "null"
      ],
      "description": "Required when fulfillment_type is delivery."
    },
    "stripe_session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "unit_of_measure": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "line_total": {
            "type": "number"
          }
        },
        "required": [
          "product_id",
          "name",
          "quantity",
          "unit_price",
          "line_total"
        ]
      }
    },
    "subtotal": {
      "type": "number"
    },
    "discount_amount": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number"
    },
    "tier_applied": {
      "type": [
        "string",
        "null"
      ],
      "description": "Loyalty tier used to compute the discount at checkout."
    },
    "points_earned": {
      "type": "number",
      "default": 0
    },
    "points_redeemed": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "status",
    "items",
    "total"
  ]
}