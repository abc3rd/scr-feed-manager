{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "staff",
        "customer"
      ],
      "default": "customer"
    },
    "loyalty_points": {
      "type": "number",
      "default": 0
    },
    "loyalty_tier": {
      "type": "string",
      "enum": [
        "bronze",
        "silver",
        "gold",
        "platinum"
      ],
      "default": "bronze"
    },
    "lifetime_points": {
      "type": "number",
      "default": 0
    },
    "phone": {
      "type": "string"
    },
    "barn_qr_id": {
      "type": "string",
      "description": "Unique token encoded in the member's barn QR sticker. Scanning it opens the member's Barn Profile quick-order page."
    }
  },
  "required": [
    "role"
  ]
}