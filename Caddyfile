{
    admin off
    auto_https off
}

:{$PORT:8080} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }

    handle /healthz {
        respond "ok" 200
    }

    # Preserve Base44's user authentication and entity access rules.
    # The upstream is fixed; no service-role keys are used by this frontend.
    handle /api/* {
        header Cache-Control "no-store"
        reverse_proxy https://app.base44.com {
            header_up Host app.base44.com
        }
    }

    handle /assets/* {
        root * /srv
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    handle {
        root * /srv
        header Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}
